# Server Configuration
PORT=5001
NODE_ENVIRONMENT=development

# Supabase Database Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Domani release management
# Comma-separated dashboard browser origins allowed to call bearer-authenticated admin APIs.
PVS_DASHBOARD_ORIGINS=http://localhost:3000
# At least 32 random bytes; may reuse DOMANI_RELEASE_CURSOR_SECRET.
ADMIN_RELEASE_CURSOR_SECRET=replace-with-a-random-cursor-secret
DOMANI_RELEASE_CURSOR_SECRET=replace-with-a-random-public-cursor-secret
# Signed server-to-server receiver used by the durable public-cache outbox dispatcher.
RELEASE_CACHE_INVALIDATION_ENDPOINT=https://domani.example.com/api/revalidate/releases
RELEASE_CACHE_INVALIDATION_SECRET=replace-with-a-random-hmac-secret
RELEASE_CACHE_DISPATCH_INTERVAL_MS=30000

# Gmail OAuth2 Configuration (for deployment notification emails)
# Setup guide: https://developers.google.com/gmail/api/quickstart/nodejs
GMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Lead Notification Configuration (optional)
# Discord webhook for lead notifications
LEAD_NOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/your-webhook-url

# Email notification settings for leads (optional - alternative to Discord)
LEAD_NOTIFY_USE_RESEND=false
LEAD_NOTIFY_FROM=noreply@yourdomain.com
LEAD_NOTIFY_TO=team@yourdomain.com
LEAD_NOTIFY_LOGO_URL=https://yourdomain.com/logo.png

# Resend API (optional - for alternative email service)
RESEND_API_KEY=re_your_resend_api_key_here

# Calendly API (for recording bookings via widget embed)
# Get from: Calendly → Integrations & Apps → Personal Access Tokens
CALENDLY_API_TOKEN=your-calendly-personal-access-token-here

# Nylas (for Domani email blasts)
NYLAS_API_KEY=your-nylas-api-key
NYLAS_GRANT_ID=your-nylas-grant-id

# Domani Supabase (read-only access for dashboard)
DOMANI_SUPABASE_URL=https://your-domani-project.supabase.co
DOMANI_SUPABASE_SERVICE_KEY=your-domani-service-role-key

# Blast secret — required X-Blast-Secret header on all email blast endpoints
# Generate with: openssl rand -hex 32
BLAST_SECRET=your-secret-here

# Media manager observability (optional)
# Logs a warning when media catalog mutation DB calls exceed this threshold.
MEDIA_DB_LATENCY_WARN_MS=1000

# Media manager uploads (optional)
# Defaults to 25 MB.
MEDIA_MAX_UPLOAD_BYTES=26214400

# Signed frontend cache revalidation (Mini Sessions/site content)
# The frontend and server must share the same secret. Existing media webhook
# variables remain supported as fallbacks during rollout.
SITE_REVALIDATION_WEBHOOK_URL=https://ifferspictures.com/api/media/revalidate
SITE_REVALIDATION_SECRET=replace-with-a-random-shared-secret
SITE_REVALIDATION_TIMEOUT_MS=5000

# Public Mini Sessions API cache window (hard-capped at 60 seconds)
MINI_SESSION_PUBLIC_MAX_AGE_SECONDS=60
